# ---------------------------------------------------------------------------
# ZaksSecondHand — local environment
#
# Copy to .env.local:  cp .env.example .env.local
# .env.local is git-ignored. Never commit real keys.
# Everything is OPTIONAL — the app runs fully offline with manual import.
# ---------------------------------------------------------------------------

# Local SQLite file. A bare filename resolves inside ./data; an absolute path
# (with or without the `file:` prefix) is used verbatim, which is how the test
# suite gets a throwaway database.
# DATABASE_URL=zaks.sqlite
# DATABASE_URL=file:/tmp/zaks-test.sqlite

# ---------------------------------------------------------------------------
# Vinted Pro Integrations (official API, allow-listed accounts only)
# Leave BOTH blank to keep the Vinted source in UNAVAILABLE / MANUAL state.
# Docs: https://pro-docs.svc.vinted.com/
# ---------------------------------------------------------------------------
# VINTED_ACCESS_KEY=
# VINTED_SIGNING_KEY=

# ---------------------------------------------------------------------------
# Email delivery via Resend (optional — used for 📧 alert digests)
# Can also be configured in-app under ⚙️ Settings instead of here.
# ---------------------------------------------------------------------------
# RESEND_API_KEY=

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# Port for `npm run dev` / `npm start`
# PORT=3000
